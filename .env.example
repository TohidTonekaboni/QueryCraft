POSTGRES_USER=azki-user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=querycraft
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Ingestion
TARGET_PRODUCTS=1000

# Read-only role used by the API to execute generated SQL
READONLY_USER=querycraft_ro
READONLY_PASSWORD=change-me
READONLY_STATEMENT_TIMEOUT=5s
TARGET_ORDER_ITEMS=5000

# SQL generation model (SQLCoder-7B-2)
# SQL_BACKEND=remote -> Ollama (or llama-server) on the host. Use this from Docker on macOS, because containers
#                       there cannot access MPS. Run `python -m app.scripts.setup_ollama` once (and again after
#                       changing *_OLLAMA_BASE, *_N_GPU_LAYERS or *_N_CTX): it pulls the base model and creates
#                       the derived model named by *_REMOTE_MODEL with those GPU/context settings.
# SQL_BACKEND=local  -> llama-cpp-python in-process from a GGUF file (Metal/MPS on macOS, CUDA, else CPU)
SQL_BACKEND=remote
SQL_REMOTE_URL=http://host.docker.internal:11434
SQL_OLLAMA_BASE=pxlksr/defog_sqlcoder-7b-2:Q4_K_M
SQL_REMOTE_MODEL=querycraft-sqlcoder
SQL_MODEL_REPO=MaziyarPanahi/sqlcoder-7b-2-GGUF
SQL_MODEL_FILE=sqlcoder-7b-2.Q4_K_M.gguf
SQL_MODEL_DIR=./models
SQL_N_GPU_LAYERS=-1
SQL_N_CTX=4096
SQL_MAX_TOKENS=300
SQL_MAX_ROWS=100

# Gemma (translation + relevance check). Same backend options as above.
# Runs on CPU by default (GEMMA_N_GPU_LAYERS=0) so it never competes with SQLCoder for GPU memory.
GEMMA_BACKEND=remote
GEMMA_REMOTE_URL=http://host.docker.internal:11434
GEMMA_OLLAMA_BASE=gemma3:4b
GEMMA_REMOTE_MODEL=querycraft-gemma
GEMMA_MODEL_REPO=ggml-org/gemma-3-4b-it-GGUF
GEMMA_MODEL_FILE=gemma-3-4b-it-Q4_K_M.gguf
GEMMA_N_GPU_LAYERS=0
GEMMA_N_CTX=2048
GEMMA_MAX_TOKENS=128

# Workflow
MAX_SQL_ATTEMPTS=3

# HF_TOKEN=            # only for app.scripts.download_model (local mode / llama-server)

# Logging (stderr; see app/logging_config.py)
# LOG_FORMAT=json for production/log collectors, text for local development.
# LOG_SENSITIVE=true also logs user questions and generated SQL; keep false unless debugging.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_SENSITIVE=false
